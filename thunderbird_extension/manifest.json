{
  "manifest_version": 3,
  "name": "Gemini Email Archive Search",
  "version": "1.0.0",
  "description": "Semantic search and Gemini-powered Q&A over your converted Outlook archive. Talks to a local FastAPI bridge on 127.0.0.1:8765; never holds API credentials itself.",
  "author": "EQ",
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-email-search@chowdhuryselfrep.com",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Gemini Email Search",
    "default_icon": {
      "32": "icon.svg",
      "48": "icon.svg"
    },
    "default_popup": "sidebar.html"
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ]
}
