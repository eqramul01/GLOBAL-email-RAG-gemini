# --- Local data — NEVER commit ---------------------------------------------
# These contain actual email content + the embeddings of that content.
# They are user data, not code, and dwarf the toolkit in size.
Maildir_Archive/
*.lancedb/
.lancedb/
.gemini_index_checkpoint.json
inventory_pre_conversion.txt
manifest.json.bak

# Indexer logs (per-run output, not toolkit code)
*.log
index.log
conversion.log

# --- Generated / system files ----------------------------------------------
# launchd plist gets generated by setup_launchd.sh into ~/Library/LaunchAgents,
# not the repo, but list here just in case someone copies it back.
*.plist

# Bridge runtime logs (live in /tmp by default)
email-bridge.*.log

# --- Python cruft ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments (if anyone makes one inside the toolkit)
venv/
env/
ENV/
.venv/

# --- Editor / OS cruft -----------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Secrets ---------------------------------------------------------------
# We use env vars for GEMINI_API_KEY, but list these in case anyone's tempted.
.env
.env.local
secrets.json
*api_key*
*api-key*

# --- Extension build artifacts ---------------------------------------------
# The .xpi gets built locally for permanent install; not needed in the repo
# (anyone can build it from thunderbird_extension/).
*.xpi
